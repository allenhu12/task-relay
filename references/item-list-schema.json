{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Relay Item List Schema",
  "description": "JSON schema for task-relay item-list.json file",
  "type": "object",
  "required": ["assignment", "items", "completed_summary", "metadata"],
  "properties": {
    "assignment": {
      "type": "object",
      "required": ["name", "description", "created", "last_updated"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the assignment"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Brief description of what the assignment accomplishes"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when assignment was created"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when assignment was last updated"
        }
      }
    },
    "next_override": {
      "type": ["string", "null"],
      "pattern": "^ITEM-[0-9]{3,}$",
      "description": "Set to an item ID to override the selection algorithm and work on this item next. Cleared (set to null) after the item is selected. Can be set by user or agent when inserting urgent items."
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "category", "description", "priority", "validation_steps", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ITEM-[0-9]{3,}$",
            "description": "Unique identifier in format ITEM-XXX"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "Category for grouping (e.g., setup, implementation, testing)"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Clear, actionable description of what needs to be done"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "Priority number (lower = higher priority)"
          },
          "validation_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            },
            "description": "List of objective verification steps"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "blocked"],
            "description": "Current status of the item"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO-8601 timestamp when item was completed (null if not completed)"
          },
          "notes": {
            "type": "string",
            "description": "Additional context or blocker information"
          }
        }
      }
    },
    "completed_summary": {
      "type": "array",
      "description": "Compact summaries of completed items (full records archived in item-list-archive.json)",
      "items": {
        "type": "object",
        "required": ["id", "description", "completed_at"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ITEM-[0-9]{3,}$",
            "description": "Item identifier matching the original item"
          },
          "description": {
            "type": "string",
            "description": "Original item description for reference"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp when item was completed"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["total_items", "completed", "in_progress", "blocked", "pending"],
      "properties": {
        "total_items": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of items"
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of completed items"
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "Number of items in progress (should be 0 or 1)"
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of blocked items"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of pending items"
        }
      }
    }
  }
}
